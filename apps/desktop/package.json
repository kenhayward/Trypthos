{
  "name": "trypthos-desktop",
  "private": true,
  "version": "0.106.0",
  "main": "src/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "pretest": "npm run build --workspace @trypthos/domain",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --config electron-builder.config.cjs",
    "icons": "node scripts/make-tray-icon.mjs && node scripts/make-app-icon.mjs",
    "predist": "npm run icons"
  },
  "dependencies": {
    "@trypthos/domain": "*",
    "electron-updater": "^6.8.10",
    "ignore": "7.0.13"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^26.17.0",
    "sharp": "^0.35.5"
  }
}
