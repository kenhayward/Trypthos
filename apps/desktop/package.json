{
  "name": "trypthos-desktop",
  "private": true,
  "version": "0.15.1",
  "main": "src/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "pretest": "npm run build --workspace @trypthos/domain",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --config electron-builder.config.cjs",
    "icons": "node scripts/make-tray-icon.mjs",
    "predist": "npm run icons"
  },
  "dependencies": {
    "@trypthos/domain": "*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "^26.15.3"
  }
}
